# Committed template — NO real values here. Copy to my-app/.env and fill in.
#   cp my-app/.env.sample my-app/.env
#
# CRA only exposes variables prefixed REACT_APP_, and reads this file once at
# dev-server startup — restart `npm start` after editing.

# Must match CLIENT_ID in backend/.env
REACT_APP_GOOGLE_CLIENT_ID=
