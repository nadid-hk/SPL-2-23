# Committed template — NO real values here. Copy to backend/.env and fill in.
#   cp backend/.env.sample backend/.env

PORT=8000
NODE_ENV=development

# Host ONLY — do not append the database name.
# db/index.db.js connects to `${MONGODB_URI}/${DB_NAME}` where DB_NAME="Khoj"
# (capital K, from src/constants.js). Mongo db names are case-sensitive.
MONGODB_URI=mongodb://127.0.0.1:27017

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Only needed for photo UPLOADS (house registration, creating a post).
# Login, browsing and chat work with these blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth. Must match REACT_APP_GOOGLE_CLIENT_ID in my-app/.env
CLIENT_ID=

# NOTE: CORS_ORIGIN is not read anywhere — app.js and index.js currently
# hardcode http://localhost:3000.
